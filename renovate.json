{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>wyrd-company/.github:renovate-config"
  ],
  "ignorePaths": [
    "templates/release/!(targets){,/**}",
    "templates/release/targets/!(product-build){,/**}",
    "templates/release/targets/product-build/!(artifact-client){,/**}",
    "tests/release/sample-target/**"
  ],
  "github-actions": {
    "description": [
      "Read the action pins of the Airlock configuration template's workflows, whose conditional file names end in a Jinja tag rather than .yml. Renovate adds these patterns to its defaults."
    ],
    "managerFilePatterns": [
      "/^templates/airlock-config/template/\\.github/workflows/[^/]+$/"
    ]
  },
  "packageRules": [
    {
      "description": [
        "Parent template owns the artifact SDK manifest and full npm lock; review updates before Toha adoption."
      ],
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "templates/release/targets/product-build/artifact-client/package.json"
      ],
      "groupName": "release artifact client",
      "automerge": false
    }
  ]
}
