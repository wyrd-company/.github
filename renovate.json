{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>wyrd-company/.github:renovate-config"
  ],
  "ignorePaths": [
    "release/!(targets){,/**}",
    "release/targets/!(product-build){,/**}",
    "release/targets/product-build/!(artifact-client){,/**}",
    "tests/release/sample-target/**"
  ],
  "packageRules": [
    {
      "description": [
        "Parent template owns the artifact SDK manifest and full npm lock; review updates before Toha adoption."
      ],
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "release/targets/product-build/artifact-client/package.json"
      ],
      "groupName": "release artifact client",
      "automerge": false
    }
  ]
}
