{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyrd.foo/delivery/apps/1",
  "title": "Delivery App authorization",
  "description": "The organization's list of GitHub Apps whose keys a workflow signs with, the role each plays, the permissions each is registered with, and the repositories each may serve. Terraform grants a key's sign role, and Airlock names a ruleset bypass actor, only for an enrolment this file allows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apps"
  ],
  "properties": {
    "$schema": {
      "const": "https://wyrd.foo/delivery/apps/1"
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "maxLength": 34,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "app_id",
        "key_vault_url",
        "permissions",
        "signers",
        "installed_on"
      ],
      "properties": {
        "role": {
          "enum": [
            "release-authority",
            "package-tags",
            "repo-wyrd-foo-publisher",
            "airlock-safe"
          ]
        },
        "tier": {
          "enum": [
            "standard",
            "trusted",
            "custodial"
          ]
        },
        "app_id": {
          "type": "integer",
          "minimum": 1
        },
        "key_vault_url": {
          "type": "string",
          "pattern": "^https://[a-z0-9-]+\\.vault\\.azure\\.net$"
        },
        "permissions": {
          "description": "The permissions the App is registered with, named as GitHub names them. Airlock's central audit requires the App's installation to carry exactly these.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*[a-z]$"
          },
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "admin"
            ]
          }
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
          },
          "description": "The repositories whose environments may sign with the App's key."
        },
        "installed_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/([A-Za-z0-9_.-]+|\\*)$"
          },
          "description": "The repositories the App may be installed on, and so the only repositories a token signed with its key can reach; `<owner>/*`, every repository of the owner, only for `airlock-safe`."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "release-authority",
                  "package-tags"
                ]
              }
            }
          },
          "then": {
            "required": [
              "tier"
            ]
          },
          "else": {
            "not": {
              "required": [
                "tier"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "const": "custodial"
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "properties": {
              "signers": {
                "maxItems": 1
              },
              "installed_on": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "description": "Airlock Safe is read-only, installed on every repository of its owner, and signed with by one repository.",
          "if": {
            "properties": {
              "role": {
                "const": "airlock-safe"
              }
            }
          },
          "then": {
            "properties": {
              "signers": {
                "maxItems": 1
              },
              "installed_on": {
                "maxItems": 1,
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/\\*$"
                }
              },
              "permissions": {
                "additionalProperties": {
                  "const": "read"
                }
              }
            }
          },
          "else": {
            "properties": {
              "installed_on": {
                "items": {
                  "not": {
                    "pattern": "/\\*$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
