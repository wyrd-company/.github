{
  "units": "sample-tool",
  "if": "always()",
  "job": {
    "runs-on": "ubuntu-latest",
    "needs": ["resolve"],
    "permissions": { "contents": "write" },
    "steps": [
      { "uses": "actions/checkout@v7" },
      { "run": "npm publish ./npm --tag ${{ github.event.inputs.dist-tag }}" }
    ]
  }
}
