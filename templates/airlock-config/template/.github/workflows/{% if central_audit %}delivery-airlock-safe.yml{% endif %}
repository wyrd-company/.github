{# relationships: implements: delivery-controls -#}
# Generated by the airlock-config template. Update with Toha; the template owns the action pin.
# The workflow of the credential environment airlock-safe. Only its job enters
# the environment, so the identity's federated credential names this file.
name: Airlock Safe
on:
  workflow_call:
permissions: {}
jobs:
  audit:
    runs-on: ubuntu-latest
    environment:
      name: airlock-safe
      deployment: false
    permissions:
      id-token: write
    steps:
      - name: Audit every repository of the owner as Airlock Safe
        uses: wyrd-company/airlock@aa31121c5ead759d07c21915004de8c52b7597a7 # epic/standards-realignment, unreleased
        with:
          mode: central
          app-id: {% raw %}${{ vars.AIRLOCK_SAFE__AIRLOCK_SAFE_APP_ID }}{% endraw %}
          key-name: {% raw %}${{ vars.AIRLOCK_SAFE__AIRLOCK_SAFE_KEY_NAME }}{% endraw %}
          installation-repositories: {% raw %}${{ vars.AIRLOCK_SAFE__AIRLOCK_SAFE_INSTALLED_ON }}{% endraw %}
          vault-url: {% raw %}${{ vars.AIRLOCK_SAFE__AZURE_KEY_VAULT_URL }}{% endraw %}
          azure-tenant-id: {% raw %}${{ vars.AIRLOCK_SAFE__AZURE_TENANT_ID }}{% endraw %}
          azure-client-id: {% raw %}${{ vars.AIRLOCK_SAFE__AZURE_CLIENT_ID }}{% endraw %}
          policy: {% raw %}${{ github.repository_owner }}{% endraw %}/.github:airlock/policy.yml
